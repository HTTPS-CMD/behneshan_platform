# ---- کپی کن به .env (کنار docker-compose.yml روی سرور) و مقدارها را پر کن ----
# رمزها را با این دستور بساز:  python3 -c "import secrets;print(secrets.token_urlsafe(48))"
# هیچ‌وقت این فایل را در git نگذار.

# دیتابیس
DB_NAME=behneshan_db
DB_USER=behneshan_user
DB_PASSWORD=CHANGE_ME
DB_HOST=db
DB_PORT=5432
REDIS_URL=redis://redis:6379/1

# جنگو
SECRET_KEY=CHANGE_ME
DEBUG=False
ALLOWED_HOSTS=api.4sogh.shop,backend,localhost,127.0.0.1
# پشت NPM: ۱  |  اگر CDN آروان هم روشن شد: ۲
NUM_PROXIES=1
CORS_ALLOWED_ORIGINS=https://4sogh.shop,https://www.4sogh.shop
CSRF_TRUSTED_ORIGINS=https://4sogh.shop,https://www.4sogh.shop,https://api.4sogh.shop

# توکن‌ها و رمزهای مشترک (باید در بک‌اند و فرانت یکی باشد)
JWT_SIGNING_KEY=CHANGE_ME
REVALIDATION_SECRET=CHANGE_ME
FRONTEND_REVALIDATE_URL=http://frontend:3000/api/revalidate

# سرویس‌های بیرونی (مقدار واقعی را خودت بگذار؛ کلید قدیمی api.ir را حتماً عوض کن)
API_IR_KEY=
SMS_PROVIDER=console
SMS_API_KEY=
SMS_LINE_NUMBER=

# فرانت‌اند
NEXT_PUBLIC_API_URL=https://api.4sogh.shop/api/v1
NEXT_PUBLIC_MEDIA_URL=https://4sogh.shop
# آدرس داخلی (بدون زیرخط! جنگو هاست دارای _ را رد می‌کند)
BACKEND_INTERNAL_URL=http://backend:8000/api/v1
